# Live trading + paper-trade gate
ROOT_FOLDER=short
DATA_ROOT=train
DATA_SET_NAME=live
PAIR=link_usdt
# Real Binance market data, no API keys, every order/account call refused
# (stocks/binance_candles_stock.py). Without this, trader.py defaults to
# mock_binance -- a frozen candle fixture, so every published indicator is a
# constant. Real trading needs STOCK_TYPE=binance, set deliberately.
STOCK_TYPE=binance_candles
# DATA_START and DATA_END are managed dynamically by the live trader
DATA_START=0
DATA_END=0
EXCHANGE_FEE=0.001
AVAIABLE_THREADS=1
IS_TRAIDER_TEST=1
USE_NN_SIMULATION=False
# trade_executor's inbound zmq PULL address (its own MQ_ZMQ_INBOUND_BIND_ADDR).
# Separate repo/deployment, reached over `trader_mq` -- an external docker
# network both compose projects attach to -- so the executor is addressed by
# its compose service name, exactly like postgres is inside its own project.
# REQUIRES: `docker network create trader_mq` once on this machine, and both
# stacks brought up with it attached (see either compose file's `networks:`).
# Do NOT route this through the host: trade_executor publishes its inbound
# port as 127.0.0.1:5555, and a host-loopback-published port is unreachable
# from this container via host.docker.internal/host-gateway (172.17.0.1) --
# measured 2026-09-20, connection refused. The publisher never raises, so
# that misconfiguration is silent: no indicator ever lands and nothing warns.
MQ_EXECUTOR_ADDR=tcp://executor:5555
# Seconds between indicator broadcasts, decoupled from the 1s trading tick.
# Must stay comfortably BELOW IndicatorPublisher's ttl_seconds (300s in
# trader.py) or readings expire in trade_executor between heartbeats; 30s
# leaves a 10x margin while writing 30x fewer rows than a per-tick publish.
MQ_INDICATOR_PUBLISH_INTERVAL_SEC=30
