# Live trading + paper-trade gate
ROOT_FOLDER=short
DATA_ROOT=train
DATA_SET_NAME=live
PAIR=link_usdt
# DATA_START and DATA_END are managed dynamically by the live trader
DATA_START=0
DATA_END=0
EXCHANGE_FEE=0.001
AVAIABLE_THREADS=1
IS_TRAIDER_TEST=1
USE_NN_SIMULATION=False
# trade_executor's inbound zmq PULL address (its own MQ_ZMQ_INBOUND_BIND_ADDR).
# Separate repo/deployment, no shared compose network -- override for any
# real deployment; this default only works when both run on the same host.
MQ_EXECUTOR_ADDR=tcp://localhost:5555
