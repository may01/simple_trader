# Live trading + paper-trade gate
ROOT_FOLDER=short
DATA_ROOT=train
DATA_SET_NAME=live
PAIR=link_usdt
# DATA_START and DATA_END are managed dynamically by the live trader
DATA_START=0
DATA_END=0
EXCHANGE_FEE=0.001
AVAIABLE_THREADS=1
IS_TRAIDER_TEST=1
USE_NN_SIMULATION=False
# trade_executor's inbound zmq PULL address (its own MQ_ZMQ_INBOUND_BIND_ADDR).
# Separate repo/deployment, no shared compose network. `live` runs on a
# bridge network, so `localhost` here is the CONTAINER's loopback, not the
# host's -- host.docker.internal (mapped via the service's extra_hosts) is
# what reaches a trade_executor running on this machine.
# REQUIRES: trade_executor must publish its inbound port on an address this
# container can reach. Its compose currently binds "127.0.0.1:5555:5555"
# (host loopback only), which host-gateway traffic does NOT reach --
# widening that is an executor-side deployment decision, not a main/ one.
MQ_EXECUTOR_ADDR=tcp://host.docker.internal:5555
# Seconds between indicator broadcasts, decoupled from the 1s trading tick.
# Must stay comfortably BELOW IndicatorPublisher's ttl_seconds (300s in
# trader.py) or readings expire in trade_executor between heartbeats; 30s
# leaves a 10x margin while writing 30x fewer rows than a per-tick publish.
MQ_INDICATOR_PUBLISH_INTERVAL_SEC=30
